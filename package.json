{
  "name": "@local/dsh-doubao-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH ↔ 豆包 双向协作桥：把豆包桌面端变成可调度的会话执行体，配一块双方共用的任务板（分工/交付/验收）。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
